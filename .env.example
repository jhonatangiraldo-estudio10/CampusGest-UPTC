# ==========================================
# CAMPUSAID UPTC - VARIABLES DE ENTORNO
# ==========================================

# 1. Variables PÚBLICAS para el Frontend (Vite)
# Clave pública / anon de Supabase (con RLS habilitado en tablas)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_SUPABASE_ANON_KEY

# 2. Variables PRIVADAS para el Servidor / Backend Vercel
# NUNCA anteponer el prefijo VITE_ ni exponer en el navegador
N8N_WEBHOOK_URL=https://TU_INSTANCIA_N8N/webhook/campusaid-solicitudes
N8N_WEBHOOK_AUTH=TU_TOKEN_O_SECRETO_N8N
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY
