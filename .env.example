# ====================================================================
# CAMPUSGEST-UPTC — VARIABLES DE ENTORNO
# ====================================================================

# 1. Variables PÚBLICAS para el Frontend (Vite)
# Clave anónima o publicable de Supabase (con RLS habilitado en tablas)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_SUPABASE_ANON_KEY

# Habilitar modo demostración estático SOLO en desarrollo local (DEV)
# En compilaciones de producción (Vite build) este flag es ignorado
VITE_ENABLE_DEMO_MODE=false

# 2. Variables PRIVADAS del Servidor / Backend (Vercel Serverless)
# NUNCA anteponer el prefijo VITE_ ni exponer en el cliente
N8N_WEBHOOK_URL=https://TU_INSTANCIA_N8N/webhook/campusaid-solicitudes
N8N_WEBHOOK_AUTH=TU_TOKEN_O_SECRETO_N8N
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY
APP_URL=https://campusgest-uptc.vercel.app
